OPENAI_API_KEY=
EDGAR_USER_AGENT="Your Name you@example.com"

# Optional: store data outside the repo (defaults to ./data)
# CONVICTION_DATA_DIR=

# Server only (EC2): the public hostname Caddy gets a certificate for
DOMAIN=
# Server only (EC2): host dir bind-mounted to /data (defaults to ./data)
DATA_HOST_DIR=

# API key the Streamlit app uses when a visitor doesn't enter their own.
# Create it with: docker compose exec api python -m scripts.create_key --name demo ...
DEMO_API_KEY=
# Hard cap on tokens per UTC day across all API keys combined
GLOBAL_DAILY_TOKENS=1000000
